{
  "tolerance": 1e-9,
  "cases": [
    {
      "name": "vertical hole through horizontal vein",
      "surveys": [
        { "depth": 0, "dip": -90, "azimuth": 0 },
        { "depth": 100, "dip": -90, "azimuth": 0 }
      ],
      "from_depth": 10.0, "to_depth": 12.0,
      "dip_direction": 0.0, "vein_dip": 0.0,
      "expected": {
        "apparent_thickness": 2.0,
        "true_thickness": 2.0,
        "hole_dip": -90.0,
        "hole_azimuth": 0.0
      },
      "source": "computed_by_hand"
    },
    {
      "name": "vertical hole through vertical vein (grazing intersection)",
      "surveys": [
        { "depth": 0, "dip": -90, "azimuth": 0 }
      ],
      "from_depth": 0.0, "to_depth": 10.0,
      "dip_direction": 0.0, "vein_dip": 90.0,
      "expected": {
        "apparent_thickness": 10.0,
        "true_thickness": 0.0,
        "hole_dip": -90.0,
        "hole_azimuth": 0.0
      },
      "source": "computed_by_hand"
    },
    {
      "name": "inclined hole at 45 deg through 60 deg vein (hand-checkable general case)",
      "surveys": [
        { "depth": 0, "dip": -45, "azimuth": 0 }
      ],
      "from_depth": 0.0, "to_depth": 10.0,
      "dip_direction": 0.0, "vein_dip": 60.0,
      "expected": {
        "apparent_thickness": 10.0,
        "true_thickness": 9.659258262890683,
        "hole_dip": -45.0,
        "hole_azimuth": 0.0
      },
      "source": "computed_by_hand: TT = 10 * cos(15deg) = 10 * (sqrt(6)+sqrt(2))/4"
    },
    {
      "name": "azimuth interpolation across 350 to 010 (unit-circle, not linear)",
      "surveys": [
        { "depth": 0, "dip": -45, "azimuth": 350 },
        { "depth": 100, "dip": -45, "azimuth": 10 }
      ],
      "from_depth": 40.0, "to_depth": 60.0,
      "dip_direction": 0.0, "vein_dip": 45.0,
      "expected": {
        "apparent_thickness": 20.0,
        "true_thickness": 20.0,
        "hole_dip": -45.0,
        "hole_azimuth": 0.0
      },
      "source": "computed_by_hand: unit-circle blend gives azimuth=0 (not 180); cosTheta=1 so TT=AT"
    },
    {
      "name": "mid-depth before first survey station (clamp to first)",
      "surveys": [
        { "depth": 50, "dip": -45, "azimuth": 0 },
        { "depth": 100, "dip": -60, "azimuth": 0 }
      ],
      "from_depth": 10.0, "to_depth": 20.0,
      "dip_direction": 90.0, "vein_dip": 45.0,
      "expected": {
        "apparent_thickness": 10.0,
        "true_thickness": 5.0,
        "hole_dip": -45.0,
        "hole_azimuth": 0.0
      },
      "source": "computed_by_hand: mid=15 < depth=50, clamps to first; cosTheta=0.5"
    },
    {
      "name": "mid-depth after last survey station (clamp to last)",
      "surveys": [
        { "depth": 0, "dip": -60, "azimuth": 0 },
        { "depth": 50, "dip": -45, "azimuth": 0 }
      ],
      "from_depth": 60.0, "to_depth": 70.0,
      "dip_direction": 90.0, "vein_dip": 45.0,
      "expected": {
        "apparent_thickness": 10.0,
        "true_thickness": 5.0,
        "hole_dip": -45.0,
        "hole_azimuth": 0.0
      },
      "source": "computed_by_hand: mid=65 > depth=50, clamps to last; cosTheta=0.5"
    },
    {
      "name": "zero survey stations (defaults -90 dip, 0 azimuth)",
      "surveys": [],
      "from_depth": 0.0, "to_depth": 10.0,
      "dip_direction": 0.0, "vein_dip": 0.0,
      "expected": {
        "apparent_thickness": 10.0,
        "true_thickness": 10.0,
        "hole_dip": -90.0,
        "hole_azimuth": 0.0
      },
      "source": "computed_by_hand: defaults give vertical hole, TT equals AT for horizontal vein"
    },
    {
      "name": "single survey station",
      "surveys": [
        { "depth": 100, "dip": -45, "azimuth": 0 }
      ],
      "from_depth": 0.0, "to_depth": 10.0,
      "dip_direction": 90.0, "vein_dip": 45.0,
      "expected": {
        "apparent_thickness": 10.0,
        "true_thickness": 5.0,
        "hole_dip": -45.0,
        "hole_azimuth": 0.0
      },
      "source": "computed_by_hand: single survey always used regardless of depth; cosTheta=0.5"
    },
    {
      "name": "negative cos-theta before abs (abs must be applied)",
      "surveys": [
        { "depth": 0, "dip": -30, "azimuth": 0 }
      ],
      "from_depth": 0.0, "to_depth": 10.0,
      "dip_direction": 180.0, "vein_dip": 60.0,
      "expected": {
        "apparent_thickness": 10.0,
        "true_thickness": 5.0,
        "hole_dip": -30.0,
        "hole_azimuth": 0.0
      },
      "source": "computed_by_hand: cosTheta=-0.5 before abs; TT=10*0.5=5"
    }
  ]
}
